# ---------------------------------------------------------------------------
# ESP32-2432S028R ("CYD"): ESP32-D0WD-V3, 4 MB flash, 2.8" 320x240 SPI panel,
# XPT2046 resistive touch, CH340 over UART0.
#
# No graphics library.  The gauge draws into a plain RGB565 framebuffer in the
# gfx component; see README.md for why LVGL is not used.
# ---------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32"

# --- Flash: GigaDevice GD25Q32, 4 MB, quad, 40 MHz ---------------------------
# 80 MHz usually works on this board; 40 is the safe default.  Raise it under
# `idf.py menuconfig -> Serial flasher config` once a full app has flashed
# cleanly.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

# --- Partition table ---------------------------------------------------------
# A factory slot plus a storage partition; see partitions.csv.  The board
# auto-downloads over the CH340's DTR/RTS lines, so there is no need for the
# round board's `bootloader` workaround - but the console command stays as a
# recovery path.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- CPU / RTOS --------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# --- Console on UART0 (CH340 -> COM port) ------------------------------------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Display -----------------------------------------------------------------
# Verified on the board this project was brought up on: the "2.8 inch" panel
# is an ST7789V, not the ILI9341 the listing claims.  RGB element order,
# landscape via swap_xy + mirror X, no INVON.
CONFIG_BSP_PANEL_ST7789=y
# CONFIG_BSP_PANEL_ILI9341 is not set
CONFIG_BSP_LCD_SWAP_XY=y
CONFIG_BSP_LCD_MIRROR_X=y
# CONFIG_BSP_LCD_MIRROR_Y is not set
# CONFIG_BSP_LCD_INVERT_COLOR is not set
# CONFIG_BSP_LCD_RGB_ORDER_BGR is not set

# The panel is rated well past 40 MHz; a full 320x240 RGB565 frame is 150 KB,
# so the SPI clock is the frame-rate ceiling.  Verified on this board: 80 MHz
# gives a clean image and ~33 fps; 40 MHz is the safe fallback if a particular
# unit shows speckle or tearing.
CONFIG_BSP_LCD_SPI_CLK_MHZ=80
CONFIG_BSP_BACKLIGHT_DEFAULT_PERCENT=60