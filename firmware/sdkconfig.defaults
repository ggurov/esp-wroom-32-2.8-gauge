# ---------------------------------------------------------------------------
# ESP32-2432S028R ("CYD"): ESP32-D0WD-V3, 4 MB flash, 2.8" 320x240 SPI panel,
# XPT2046 resistive touch, CH340 over UART0.
#
# No graphics library.  The gauge draws into a plain RGB565 framebuffer in the
# gfx component; see README.md for why LVGL is not used.
# ---------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32"

# --- Flash: GigaDevice GD25Q32, 4 MB, quad, 40 MHz ---------------------------
# 80 MHz usually works on this board; 40 is the safe default.  Raise it under
# `idf.py menuconfig -> Serial flasher config` once a full app has flashed
# cleanly.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

# --- Partition table ---------------------------------------------------------
# A factory slot plus a storage partition; see partitions.csv.  The board
# auto-downloads over the CH340's DTR/RTS lines, so there is no need for the
# round board's `bootloader` workaround - but the console command stays as a
# recovery path.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- CPU / RTOS --------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# --- Console on UART0 (CH340 -> COM port) ------------------------------------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Display -----------------------------------------------------------------
# The panel is rated well past 40 MHz; a full 320x240 RGB565 frame is 150 KB,
# so the SPI clock is the frame-rate ceiling.  40 MHz gives about 31 ms per
# frame (32 fps), 80 MHz about 15 ms (60 fps).
CONFIG_BSP_LCD_SPI_CLK_MHZ=40
CONFIG_BSP_BACKLIGHT_DEFAULT_PERCENT=60